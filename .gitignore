.ruff_cache/

# Auth Tokens / Hidden Files
.hf_token
.wandb_api_key
.*_token
.*api_key

# IDE Caches
.idea/
.vscode/

# Mac OS
.DS_Store

# Caches and Datasets
cache/
data/

# Rollout videos and wandb logs
rollouts/
wandb/

# Training artifacts: large checkpoints/runs that should NOT be in version control.
# Your friend will produce their own; the base model is downloaded from HF, not committed.
# NOTE: leading slash anchors these to the repo root, so we don't accidentally exclude
# small per-component "checkpoints/" subfolders (e.g. vq/.../checkpoints/model.pt).
/runs/
/checkpoints/

# Eval log outputs (auto-generated, can grow large)
experiments/logs/

# tmux scrollbacks / temp scratch
.tmp/

# OS / editor noise
*.swp
*.swo

# ── Data-collection outputs (large; never commit) ─────────────────────────
# Per-task replay buffers, MP4 videos, converted HDF5s, ad-hoc sync checks.
data_collection/recordings/

# ── phone_data_bridge: local copy of source zarr + stage-A intermediate HDF5
phone_data_bridge/source/
phone_data_bridge/recordings/

# Raw artifact patterns (catch-all in case files appear outside recordings/)
*.zarr/
*.mp4
*.hdf5
*.h5

# ── External / third-party clones (e.g. rlds_dataset_builder upstream) ───
# Our customized RLDS builder lives at data_collection/rlds_builder/ and IS
# tracked. The full upstream clone under external/ is reference-only.
external/

# ── RLDS / TFDS output trees (large; never commit) ───────────────────────
# Also covered by the `data/` rule above, but pin them explicitly.
data/rlds/

# ── Local model checkpoints downloaded for finetuning ─────────────────────
/checkpoints/

# ── HF / TIMM caches if HF_HOME points inside the repo ───────────────────
hf_cache/
.cache/
